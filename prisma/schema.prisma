generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// User model representing any person registered in the system
model User {
  id             Int            @id @default(autoincrement())
  name           String
  email          String         @unique
  passwordHash   String
  phone          String?
  avatarUrl      String?
  isActive             Boolean        @default(true)
  requirePasswordReset Boolean        @default(false)
  lastLogin            DateTime?
  departmentId   Int?
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?
  updatedAt      DateTime       @default(now()) @updatedAt
  role           Role           @default(LECTURER)
  createdTerms   AcademicTerm[]
  activityLogs   ActivityLog[]
  hodDepartments Department[]   @relation("HoDepartment")
  notifications  Notification[]
  observedBy     Observation[]  @relation("ObservedLecturer")
  observing      Observation[]  @relation("ObserverUser")
  moderationsAsInternal ExamModeration[] @relation("ModerationInternalExaminer")
  moderationsAsModerator ExamModeration[] @relation("ModerationModerator")
  moderationsAssigned ExamModeration[]   @relation("ModerationAssignedBy")
  teachingObserved   TeachingObservation[] @relation("TeachingObservedLecturer")
  teachingObserver   TeachingObservation[] @relation("TeachingObserverUser")
  teachingAssigned   TeachingObservation[] @relation("TeachingAssignedBy")
  passwordResets PasswordReset?
  resources      Resource[]     @relation("LecturerResources")
  submissions    Submission[]
  department     Department?    @relation("UserDepartment", fields: [departmentId], references: [id])
  assignedSections CourseSection[] @relation("SectionLecturer")

  @@index([departmentId])
  @@index([role])
  @@index([isActive])
}

/// Academic departments within the institution
model Department {
  id        Int        @id @default(autoincrement())
  name      String
  code      String     @unique
  hodId     Int?
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  updatedAt DateTime   @default(now()) @updatedAt
  courses   Course[]
  hod       User?      @relation("HoDepartment", fields: [hodId], references: [id])
  resources Resource[] @relation("DepartmentResources")
  users     User[]     @relation("UserDepartment")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Educational resources uploaded by lecturers
model Resource {
  id           Int            @id @default(autoincrement())
  title        String
  description  String?
  url          String
  lecturerId   Int
  departmentId Int?
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?
  feedback     String?
  updatedAt    DateTime       @default(now()) @updatedAt
  type         ResourceType   @default(OTHER)
  status       ResourceStatus @default(PENDING)
  department   Department?    @relation("DepartmentResources", fields: [departmentId], references: [id])
  lecturer     User           @relation("LecturerResources", fields: [lecturerId], references: [id])

  @@index([lecturerId])
  @@index([departmentId])
  @@index([status])
}

/// Deadlines for academic submissions
model Deadline {
  id          Int            @id @default(autoincrement())
  label       String
  dueDate     DateTime
  createdBy   Int
  createdAt   DateTime       @default(now())
  termId      Int?
  updatedAt   DateTime       @default(now()) @updatedAt
  type        SubmissionType
  term        AcademicTerm?  @relation(fields: [termId], references: [id])
  submissions Submission[]
}

/// Accredited academic courses
model Course {
  id              Int             @id @default(autoincrement())
  code            String          @unique
  title           String
  credits         Int             @default(3)
  departmentId    Int?
  isInstitutional Boolean         @default(false)
  categoryId      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  deletedAt       DateTime?
  category        CourseCategory? @relation(fields: [categoryId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  masterSyllabus  MasterSyllabus?
  sections        CourseSection[]
  curriculumMaps  CurriculumMap[]

  @@index([departmentId])
  @@index([categoryId])
}

/// Academic programs (e.g., BSc Computer Science, BEng Electrical)
model Program {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  code           String          @unique
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  curriculumMaps CurriculumMap[]
}

model CurriculumMap {
  id          Int      @id @default(autoincrement())
  programId   Int
  courseId    Int
  level       Int      // 100, 200, 300, 400
  semester    Int      // 1 or 2
  isMandatory Boolean  @default(true)

  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
  @@index([programId])
  @@index([courseId])
  @@index([programId, level, semester])
}

/// Categorization for courses (e.g., Core, Elective, Gen Ed)
model CourseCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isGlobal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  courses     Course[]
}

/// The authorized syllabus for a course that all lecturers must follow
model MasterSyllabus {
  id              Int      @id @default(autoincrement())
  courseId        Int      @unique
  mandatoryTopics Json
  learningOutcomes Json?
  version         Int      @default(1)
  lastUpdatedBy   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  course          Course   @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

enum SessionType {
  REGULAR
  WEEKEND
}

model CourseSection {
  id            Int          @id @default(autoincrement())
  courseId      Int
  termId        Int
  lecturerId    Int?
  name          String
  session       SessionType  @default(REGULAR)
  
  course        Course       @relation(fields: [courseId], references: [id])
  term          AcademicTerm @relation(fields: [termId], references: [id])
  lecturer      User?        @relation("SectionLecturer", fields: [lecturerId], references: [id])
  
  @@index([courseId])
  @@index([termId])
  @@index([lecturerId])
}

/// Specific academic periods (semesters/terms)
model AcademicTerm {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean       @default(false)
  createdBy    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  admin        User          @relation(fields: [createdBy], references: [id])
  deadlines    Deadline[]
  observations Observation[]
  examModerations ExamModeration[]
  teachingObservations TeachingObservation[]
  submissions  Submission[]
  courseSections CourseSection[]
}

/// Lecturers academic submissions (calendars, topics, etc.)
model Submission {
  id          Int                 @id @default(autoincrement())
  lecturerId  Int
  title       String
  filePath    String?
  deadlineId  Int?
  submittedAt DateTime?
  createdAt   DateTime            @default(now())
  feedback    String?
  termId      Int?
  updatedAt   DateTime            @default(now()) @updatedAt
  type        SubmissionType
  content     Json?
  status      SubmissionStatus    @default(PENDING)
  deadline    Deadline?           @relation(fields: [deadlineId], references: [id])
  lecturer    User                @relation(fields: [lecturerId], references: [id])
  term        AcademicTerm?       @relation(fields: [termId], references: [id])
  versions    SubmissionVersion[]

  @@index([lecturerId])
  @@index([status])
  @@index([deadlineId])
  @@index([termId])
  @@index([lecturerId, status])
}

model SubmissionVersion {
  id           Int        @id @default(autoincrement())
  submissionId Int
  isDraft      Boolean    @default(true)
  savedAt      DateTime   @default(now())
  snapshot     Json
  submission   Submission @relation(fields: [submissionId], references: [id])
}

/// Classroom observation and peer review records
model Observation {
  id                  Int               @id @default(autoincrement())
  lecturerId          Int
  observerId          Int
  sessionDate         DateTime?
  venue               String?
  courseCode          String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt
  status              ObservationStatus @default(PENDING)
  feedback            String?
  termId              Int?
  // Structured APR Form A fields
  reviewData          Json?
  lecturer            User              @relation("ObservedLecturer", fields: [lecturerId], references: [id])
  observer            User              @relation("ObserverUser", fields: [observerId], references: [id])
  term                AcademicTerm?     @relation(fields: [termId], references: [id])


  @@index([lecturerId])
  @@index([observerId])
  @@index([status])
  @@index([termId])
}

/// Examination Moderation Form C Records
model ExamModeration {
  id            Int               @id @default(autoincrement())
  courseCode    String
  lecturerId    Int               // Internal Examiner
  moderatorId   Int               // Peer Moderator
  deoId         Int               // Assigned by DEO
  termId        Int?
  status        ObservationStatus @default(PENDING)
  reviewData    Json?             // APR Form C data
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  lecturer      User              @relation("ModerationInternalExaminer", fields: [lecturerId], references: [id])
  moderator     User              @relation("ModerationModerator", fields: [moderatorId], references: [id])
  deo           User              @relation("ModerationAssignedBy", fields: [deoId], references: [id])
  term          AcademicTerm?     @relation(fields: [termId], references: [id])

  @@index([lecturerId])
  @@index([moderatorId])
  @@index([deoId])
  @@index([status])
  @@index([termId])
}

/// Teaching Observation Form B Records
model TeachingObservation {
  id            Int               @id @default(autoincrement())
  courseCode    String
  lecturerId    Int               // Teacher Observed
  observerId    Int               // Teaching Observer
  deoId         Int               // Assigned by DEO
  termId        Int?
  sessionDate   DateTime?         // Date of lesson
  venue         String?
  status        ObservationStatus @default(PENDING)
  formBData     Json?             // APR Form B data
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  lecturer      User              @relation("TeachingObservedLecturer", fields: [lecturerId], references: [id])
  observer      User              @relation("TeachingObserverUser", fields: [observerId], references: [id])
  deo           User              @relation("TeachingAssignedBy", fields: [deoId], references: [id])
  term          AcademicTerm?     @relation(fields: [termId], references: [id])

  @@index([lecturerId])
  @@index([observerId])
  @@index([deoId])
  @@index([status])
  @@index([termId])
}



model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([userId, read])
}

/// Audit trail for system activities
model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  ip        String?
  createdAt DateTime @default(now())
  detail    Json?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Generated system reports
model Report {
  id          Int        @id @default(autoincrement())
  generatedBy Int
  filePath    String
  generatedAt DateTime   @default(now())
  type        ReportType
  filters     Json?
}

enum Role {
  LECTURER
  HOD
  DEO
  ADMIN
  SUPER_ADMIN
}

enum ResourceType {
  PDF
  SLIDES
  CODE
  VIDEO
  LINK
  IMAGE
  SPREADSHEET
  DOCUMENT
  OTHER
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionType {
  SEMESTER_CALENDAR
  COURSE_TOPICS
  OBSERVATION_REPORT
  WEEKLY_TOPICS
}

enum SubmissionStatus {
  DRAFT
  PENDING
  SUBMITTED
  LATE
  REVIEWED
  APPROVED
  REJECTED
}

enum ObservationStatus {
  PENDING
  COMPLETED
  REVIEWED
}



enum ReportType {
  lecturer_summary
  department_compliance
  audit_report
}
