# Database Connection (Neon PostgreSQL)
# For local dev, you can use a Neon dev branch or local Postgres
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth Configuration
# Run 'openssl rand -base64 32' to generate a secret
AUTH_SECRET="your-secret-here"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob Storage (Required for persistent file uploads on Vercel / serverless production)
# Generated automatically when creating a Vercel Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Email Configuration (Resend or SMTP)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="LAMAS System <noreply@lamas.edu>"

# SMTP Fallback Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Gemini AI API Key (for syllabus parsing / extraction)
GEMINI_API_KEY="your-gemini-api-key"

# Optional: enable bundle analysis locally
ANALYZE=false

# Connection Pooling (tune for serverless / production)
# DATABASE_POOL_MAX=5           # Max pool connections (default: 5 prod, 10 dev)
# DATABASE_IDLE_TIMEOUT=10000   # Idle timeout in ms (default: 10000)
# DATABASE_CONNECTION_TIMEOUT=30000  # Connection timeout in ms (default: 30000)

# Observability — Sentry error tracking (optional)
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Logging
# LOG_LEVEL=info   # debug | info | warn | error
